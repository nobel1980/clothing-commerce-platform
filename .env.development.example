# =============================================================================
# Clothing Commerce Platform - Development Environment Variables
# =============================================================================

# Global / Shared
NODE_ENV=development
APP_NAME="Clothing Commerce Platform"

# Frontend (apps/web)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost/api

# Backend (apps/api)
APP_ENV=local
APP_KEY=base64:u3G8mQv8J3P0b1h6qXw9Y2Z4k8A1C5E7g9I0K2M4O6Q=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database (MySQL 8)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clothing_commerce
DB_USERNAME=root
DB_PASSWORD=

# Redis Cache & Queues
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=secret_redis_pass
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Logging & Mail
LOG_CHANNEL=stack
LOG_LEVEL=debug
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@clothing-commerce.local"
MAIL_FROM_NAME="${APP_NAME}"
