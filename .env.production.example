# =============================================================================
# Clothing Commerce Platform - Production Environment Variables
# =============================================================================

# Global / Shared
NODE_ENV=production
APP_NAME="Clothing Commerce Platform"

# Frontend (apps/web)
NEXT_PUBLIC_APP_URL=https://clothing-commerce.example.com
NEXT_PUBLIC_API_URL=https://clothing-commerce.example.com/api
API_INTERNAL_URL=http://api:8000/api
REVALIDATION_SECRET=REPLACE_WITH_STRONG_REVALIDATION_WEBHOOK_SECRET

# Backend (apps/api)
APP_ENV=production
APP_KEY=GENERATE_SECURE_APP_KEY_USING_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://clothing-commerce.example.com

# Database (MySQL 8 Production)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=clothing_commerce_prod
DB_USERNAME=clothing_user
DB_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_DB_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD

# Redis Cache & Queues (Cluster/Production)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_REDIS_PASSWORD
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Logging & Monitoring
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=REPLACE_WITH_SENDGRID_OR_SES_API_KEY
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="orders@clothing-commerce.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payment Gateways (Production - Inject via Runtime Secrets)
PAYMENT_ALLOW_MOCK_GATEWAY=false
BKASH_SANDBOX=false
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=REPLACE_WITH_PRODUCTION_BKASH_APP_KEY
BKASH_APP_SECRET=REPLACE_WITH_PRODUCTION_BKASH_APP_SECRET
BKASH_USERNAME=REPLACE_WITH_PRODUCTION_BKASH_USERNAME
BKASH_PASSWORD=REPLACE_WITH_PRODUCTION_BKASH_PASSWORD
NAGAD_SANDBOX=false
NAGAD_BASE_URL=https://api.mynagad.com
NAGAD_MERCHANT_ID=REPLACE_WITH_PRODUCTION_NAGAD_MERCHANT_ID
NAGAD_PUBLIC_KEY=REPLACE_WITH_PRODUCTION_NAGAD_PUBLIC_KEY
NAGAD_PRIVATE_KEY=REPLACE_WITH_PRODUCTION_NAGAD_PRIVATE_KEY
SSLCOMMERZ_SANDBOX=false
SSLCOMMERZ_BASE_URL=https://securepay.sslcommerz.com
SSLCOMMERZ_STORE_ID=REPLACE_WITH_PRODUCTION_SSLCOMMERZ_STORE_ID
SSLCOMMERZ_STORE_PASSWORD=REPLACE_WITH_PRODUCTION_SSLCOMMERZ_STORE_PASSWORD

# Courier Providers (Production - Inject via Runtime Secrets)
SHIPPING_DEFAULT_COURIER=pathao
PATHAO_SANDBOX=false
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=REPLACE_WITH_PRODUCTION_PATHAO_CLIENT_ID
PATHAO_CLIENT_SECRET=REPLACE_WITH_PRODUCTION_PATHAO_CLIENT_SECRET
PATHAO_USERNAME=REPLACE_WITH_PRODUCTION_PATHAO_USERNAME
PATHAO_PASSWORD=REPLACE_WITH_PRODUCTION_PATHAO_PASSWORD
PATHAO_STORE_ID=1
PATHAO_WEBHOOK_SECRET=REPLACE_WITH_PRODUCTION_PATHAO_WEBHOOK_SECRET
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=REPLACE_WITH_PRODUCTION_STEADFAST_API_KEY
STEADFAST_SECRET_KEY=REPLACE_WITH_PRODUCTION_STEADFAST_SECRET_KEY
STEADFAST_WEBHOOK_SECRET=REPLACE_WITH_PRODUCTION_STEADFAST_WEBHOOK_SECRET
REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
REDX_ACCESS_TOKEN=REPLACE_WITH_PRODUCTION_REDX_ACCESS_TOKEN
REDX_WEBHOOK_SECRET=REPLACE_WITH_PRODUCTION_REDX_WEBHOOK_SECRET
