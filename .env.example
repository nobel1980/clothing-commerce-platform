# ========================================================
# Clothing Commerce Platform - Environment Configuration
# ========================================================

# General
NODE_ENV=development
APP_NAME="Clothing Commerce Platform"

# Frontend (apps/web)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Backend (apps/api)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clothing_commerce
DB_USERNAME=root
DB_PASSWORD=

# Redis Cache & Queue
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail / Notifications
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@clothingcommerce.com"
MAIL_FROM_NAME="${APP_NAME}"
