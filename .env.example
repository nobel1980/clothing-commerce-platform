# ========================================================
# Clothing Commerce Platform - Environment Configuration
# ========================================================

# General
NODE_ENV=development
APP_NAME="Clothing Commerce Platform"

# Frontend (apps/web)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
API_INTERNAL_URL=http://localhost:8000/api
REVALIDATION_SECRET=dev_revalidation_secret_placeholder

# Backend (apps/api)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clothing_commerce
DB_USERNAME=root
DB_PASSWORD=

# Redis Cache & Queue
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail / Notifications
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@clothingcommerce.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payment Gateways (Bangladesh - Placeholders Only)
BKASH_SANDBOX=true
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_SANDBOX=true
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Courier Providers (Bangladesh - Placeholders Only)
SHIPPING_DEFAULT_COURIER=pathao
PATHAO_SANDBOX=true
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=1
PATHAO_WEBHOOK_SECRET=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_SECRET=
REDX_BASE_URL=https://sandbox.redx.com.bd/v1.0.0-beta
REDX_ACCESS_TOKEN=
REDX_WEBHOOK_SECRET=
