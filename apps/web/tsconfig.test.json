{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"],
    "rootDir": "../..",
    "outDir": "./.test-dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@clothing-commerce/types": ["../../packages/types/src/index.ts"],
      "@clothing-commerce/ui": ["../../packages/ui/src/index.tsx"]
    }
  },
  "include": ["src/__tests__/storefront.test.tsx"]
}

